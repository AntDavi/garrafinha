{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garrafinha-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Modelo do Gemini (troque sem redeploy de código: edite e rode `npm run deploy`).
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // Origens web permitidas (vírgula). O app nativo não envia Origin e não é afetado.
    "ALLOWED_ORIGINS": "",
    "SCAN_DAILY_LIMIT_PER_INSTALL": "5",
    "SCAN_DAILY_LIMIT_PER_IP": "30",
    "INSIGHTS_DAILY_LIMIT_PER_INSTALL": "10"
  },
  // Contadores diários. Crie com: npx wrangler kv namespace create RATE_KV
  "kv_namespaces": [{ "binding": "RATE_KV", "id": "COLE_AQUI_O_ID_DO_NAMESPACE" }],
  // Proteção contra rajadas por IP (gratuito; período de 10 ou 60 s).
  "ratelimits": [
    { "name": "BURST_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
  // Secret (não fica aqui): npx wrangler secret put GEMINI_API_KEY
}
